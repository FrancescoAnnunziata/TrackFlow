APP_NAME=TrackFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Una settimana: su un dispositivo già conosciuto non si rifà il login
# (password + codice a due fattori) prima di 7 giorni di inattività.
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@g8labs.it"
MAIL_FROM_NAME="g8labs"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fatture in Cloud (OAuth2). Il redirect deve combaciare con quello registrato
# nell'app su https://developers.fattureincloud.it (di norma APP_URL/fic/callback).
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
FIC_REDIRECT_URI="${APP_URL}/fic/callback"

# API in ingresso per le fatture da abbonamento (chiamata da personal-ticketing).
# Vuoto = endpoint spento. Il segreto firma il corpo della richiesta e va
# generato lungo e casuale (es. `openssl rand -hex 32`), poi copiato identico
# nell'.env del chiamante. Vedi docs/api-abbonamenti.md.
BILLING_API_SECRET=
# BILLING_API_TOLERANCE=300
# BILLING_API_SOURCES=personal-ticketing

# Intestazioni dei documenti: dal 28/11/2026 stanno nella tabella `emittenti`
# (pagina Emittenti). Le variabili G8LABS_* e GIORGIO_* servono solo alla
# migrazione che le copia; dopo il deploy si possono togliere.

# A-Cube (fatturazione elettronica della P.IVA personale). Le credenziali sono
# quelle dell'account A-Cube; ACUBE_ENV vale sandbox o production.
ACUBE_ENV=sandbox
ACUBE_EMAIL=
ACUBE_PASSWORD=

# Shopify — incassi giornalieri dell'e-commerce (P.IVA personale).
# Custom app creata dal pannello Shopify, scope read_orders in sola lettura.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_RESYNC_DAYS=14

# A chi arriva la mail una settimana prima del rinnovo di un abbonamento fornitore.
ABBONAMENTI_PROMEMORIA_A=giorgio.giotto@g8labs.it
